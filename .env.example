# ---- LLM (Groq) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Model used for final grounded answer generation + RAGAS judge
GROQ_MODEL=openai/gpt-oss-120b
# Cheaper/faster model used for query expansion
GROQ_EXPANSION_MODEL=openai/gpt-oss-20b
# Non-thinking model used as the RAGAS judge (thinking models leak <think> blocks)
GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# ---- Vector store (Milvus) ----
MILVUS_URI=http://localhost:19530
# No-Docker fallback: set a filename to use embedded milvus-lite instead
MILVUS_LOCAL_DB=
MILVUS_COLLECTION=policy_chunks

# ---- Models (local, via sentence-transformers) ----
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Retrieval tuning ----
EXPANSION_COUNT=3
RETRIEVAL_TOP_K=8
RERANK_TOP_K=3
